#!/usr/bin/env sh
set -e

# Suppress Vite native loader warning in pre-commit output
export VITE_CONFIG_NATIVE_IGNORE_WARNING=true

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m'

printf "\n${CYAN}${BOLD}◈ [GenZ Quality Gate]${NC} Running pre-commit verification...\n"
printf "${BOLD}------------------------------------------------------------${NC}\n"

# Phase 1: Format & Lint staged files
printf "${CYAN}▶ [1/2] Formatting & linting staged files (lint-staged)...${NC}\n"
if ! npx lint-staged -r --max-arg-length 2000; then
  printf "\n${RED} [GenZ Pre-Commit] Formatting or linting failed. Please resolve the errors above.${NC}\n\n"
  exit 1
fi

# Phase 2: Run related tests for modified files (with domain fallback for UI)
printf "\n${CYAN}▶ [2/2] Testing modified files (vitest related & domain suites)...${NC}\n"
if ! node scripts/test-staged.mjs; then
  printf "\n${RED} [GenZ Pre-Commit] Unit or domain tests failed for modified files.${NC}\n\n"
  exit 1
fi

printf "${BOLD}------------------------------------------------------------${NC}\n"
printf "${GREEN} [GenZ Pre-Commit] All quality checks passed. Ready to commit!${NC}\n\n"
