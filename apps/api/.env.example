# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS Allowed Origins (comma-separated URLs for web storefront, seller/admin desks, and mobile previews)
CORS_ORIGIN=http://localhost:3000,http://localhost:4151,http://127.0.0.1:3000,http://localhost:4252,http://localhost:4353

# Supabase Auth & Database (matches root / web settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway & Webhook Signature Verification
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Transactional Notifications & Logistics
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=GenZ Online <onboarding@genzonline.in>
DELHIVERY_API_KEY=your_delhivery_api_key

