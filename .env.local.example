# Get these from your Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Used to build the email confirmation redirect link in signup
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API Key for dispatching seller approval emails (https://resend.com)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=<onboarding@resend.dev>

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_51aBCDeFGhIJkL
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Server-side key id for the Refunds API (falls back to NEXT_PUBLIC_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Webhook secret from Razorpay Dashboard > Webhooks (events: refund.processed, refund.failed)
# Endpoint: https://<web-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Optional sender for customer order/refund emails (defaults to RESEND_FROM_EMAIL)
RESEND_ORDERS_FROM_EMAIL=GenZ Online <orders@genzonline.in>
